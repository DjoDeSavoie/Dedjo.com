# Variables d'environnement du projet Dedjo.
# Copie ce fichier en .env pour le développement local (.env n'est jamais committé)
# et renseigne les mêmes variables sur Netlify : Site configuration > Environment variables.
# Toutes sont lues par les fonctions Netlify, côté serveur : aucune n'est envoyée au navigateur.

# Newsletter (Brevo) — netlify/functions/newsletter.ts
BREVO_API_KEY=
BREVO_LIST_ID=

# Formulaire de contact → Google Sheet — netlify/functions/contact.ts
GSHEET_CONTACT_WEBHOOK_URL=

# Commandes → Google Apps Script (Sheet + notification Telegram) — netlify/functions/commande.ts
# Mise en place pas à pas : apps-script/DEPLOIEMENT.md
# URL du déploiement Apps Script (se termine par /exec)
GSHEET_ORDER_WEBHOOK_URL=
# Même valeur que la propriété SHARED_SECRET du script
ORDER_SHARED_SECRET=
